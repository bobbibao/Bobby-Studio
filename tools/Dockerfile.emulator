# Official Firebase Authentication Emulator, pinned through tools/yarn.lock.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends default-jre-headless && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json yarn.lock firebase.docker.json ./
RUN yarn install --frozen-lockfile
EXPOSE 9099
CMD ["node_modules/.bin/firebase", "emulators:start", "--only", "auth", "--project", "demo-bobby-studio", "--config", "firebase.docker.json"]
