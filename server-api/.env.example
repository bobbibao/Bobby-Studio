# Bobby Studio API. `node scripts/setup.mjs` generates a working development .env.
# Never commit real values. Production secrets belong in the deployment secret store.

# Profile: development | test | staging | production (required, never inferred)
APP_ENV=development
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Comma-separated browser origins; required and wildcard-free in staging/production
ALLOWED_CORS_DOMAINS=http://localhost:4200

# PostgreSQL (durable authority for jobs, results and credits)
DATABASE_URL=
SHADOW_DATABASE_URL=

# Redis (queue transport and projection; run with noeviction + persistence)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Firebase Authentication
FIREBASE_PROJECT_ID=demo-bobby-studio
# Development/test only: official Auth Emulator as host:port (no URL scheme). Rejected in staging/production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Staging/production: prefer Application Default Credentials. Legacy service-account variables are still read:
# PROJECT_ID, CLIENT_EMAIL, PRIVATE_KEY

# Asset storage: local (development/test only) or gcs
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/absolute/path/to/.data/assets
BOBBY_GCS_BUCKET_NAME=

# Internal worker credential used for claim/callback requests (>= 24 chars)
WORKER_SERVICE_SECRET=

# Image provider profile (live activation is configuration only; see worker/.env.example)
IMAGE_PROVIDER=openai
IMAGE_PROVIDER_MODE=simulated

# Signs short-lived asset access URLs (>= 24 chars)
ASSET_URL_SECRET=

# Optional integrations; each is disabled when its key is empty
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4200/profile
STRIPE_CANCEL_URL=http://localhost:4200/profile
STRIPE_BASIC_PRICE_ID=
STRIPE_BASIC_PRICE_YEARLY_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PRICE_YEARLY_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_TEAM_PRICE_YEARLY_ID=
INVITE_TEAM_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Logging (deployed environments write rotating files)
LOGGING_LEVEL=
LOGGING_DAYS=
LOGGING_FOLDER_PATH=
