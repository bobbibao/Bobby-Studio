# Bobby Studio worker. `node scripts/setup.mjs` generates a working development .env.
# Never commit real values.

APP_ENV=development
NODE_ENV=development

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Internal API (claim/callback) and the shared service credential (>= 24 chars, same as the API's)
API_INTERNAL_URL=http://127.0.0.1:3000/api
WORKER_SERVICE_SECRET=

# Health/readiness endpoint. Use 0.0.0.0 inside containers.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3100
WORKER_CONCURRENCY=2

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/absolute/path/to/.data/assets
BOBBY_GCS_BUCKET_NAME=

# Image provider profile.
# Development: simulator (loopback only, enforced by validation). Live activation changes only these
# four values together: provider, mode, base URL/model and the secret key.
#   openai live: IMAGE_PROVIDER=openai IMAGE_PROVIDER_MODE=live IMAGE_PROVIDER_BASE_URL=https://api.openai.com
#   gemini live: IMAGE_PROVIDER=gemini IMAGE_PROVIDER_MODE=live IMAGE_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com
# Routine key rotation within a live profile changes only IMAGE_PROVIDER_API_KEY.
IMAGE_PROVIDER=openai
IMAGE_PROVIDER_MODE=simulated
IMAGE_PROVIDER_BASE_URL=http://127.0.0.1:4010
IMAGE_PROVIDER_API_KEY=
IMAGE_MODEL=simulated-openai-image

LOGGING_LEVEL=
LOGGING_DAYS=
LOGGING_FOLDER_PATH=
